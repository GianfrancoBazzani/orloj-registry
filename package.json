{
  "name": "orloj-registry",
  "private": true,
  "description": "MCPs contracts interfaces for AI agents",
  "scripts": {
    "start": "./dev.sh",
    "start:no-docker": "./dev.sh --no-docker",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f postgres",
    "sentiment:setup": "cd packages/substreams-sentiment && ./setup.sh",
    "sentiment:setup:docker": "cd packages/substreams-sentiment && ./setup.sh --docker",
    "registry": "cd packages/registry && cargo run",
    "app": "pnpm --filter app dev",
    "lint": "pnpm --filter app lint"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}

    "@spacecomputer-io/orbitport-sdk-ts": "0.2.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "pg": "8.20.0",
    "viem": "2.48.11",
    "zod": "4.4.3"
  }
}

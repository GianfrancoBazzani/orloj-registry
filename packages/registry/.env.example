# Postgress connect url
DATABASE_URL=""

# 1Claw vault provider
ONECLAW_API_KEY=""
ONECLAW_BASE_URL="https://api.1claw.xyz"

# SpaceComputer / Orbitport KMS credentials.
ORBITPORT_CLIENT_ID=""
ORBITPORT_CLIENT_SECRET=""

# Uniswap mcp. One key, two different Uniswap services:
#   the Trading API   — swaps (quote, swap)
#   the Liquidity API — Uniswap V3 LP positions, Ethereum Sepolia only
UNISWAP_API_KEY=""
UNISWAP_API_URL="https://trade-api.gateway.uniswap.org/v1"
UNISWAP_LP_API_URL="https://liquidity.api.uniswap.org"

# Onchain market sentiment MCP (`feeling`).
#
# SUBSTREAMS_API_TOKEN is a JWT, NOT the API key. Passing the raw `server_...` key
# fails with `stream auth failure: invalid JWT token`. Exchange it once — the JWT
# lasts ~3650 days:
#
#   export SUBSTREAMS_API_TOKEN=$(curl -sS -X POST \
#     https://auth.streamingfast.io/v1/auth/issue \
#     -H "Content-Type: application/json" \
#     -d "{\"api_key\":\"$SUBSTREAMS_API_KEY\"}" \
#     | python3 -c "import sys,json;print(json.load(sys.stdin)['token'])")
#
# Also requires the `substreams` CLI on PATH (`brew install streamingfast/tap/substreams`)
# and a built module — see packages/substreams-sentiment/README.md.
SUBSTREAMS_API_TOKEN=""

# Everything below has a working default; set only to override.
# SENTIMENT_MANIFEST_DIR defaults to ../substreams-sentiment, which is correct when
# running from packages/registry/. Set it if you start the server from elsewhere.
# SENTIMENT_MANIFEST_DIR="/abs/path/to/packages/substreams-sentiment"
# SUBSTREAMS_ENDPOINT="mainnet.eth.streamingfast.io:443"
# ETH_RPC_URL="https://ethereum-rpc.publicnode.com"
# SUBSTREAMS_BIN="substreams"

# miscelanious
PORT=3001

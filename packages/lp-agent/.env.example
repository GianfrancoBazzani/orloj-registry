# Orloj Uniswap MCP (JSON-RPC tools/call)
# Example: http://127.0.0.1:3001/interface/uniswap/mcp
ORLOJ_MCP_URL=
ORLOJ_AGENT_BEARER_TOKEN=

# The Graph decentralized gateway (Bearer auth — do not put the key in the URL)
THE_GRAPH_API_KEY=
# Optional override; default is the Sepolia uniswap-v3 subgraph below
# THE_GRAPH_SUBGRAPH_ID=2vXTcbEvA3TGTufatwRVUXQjJZDKCHmzZmZKYYXxaeeR
# THE_GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api/subgraphs/id

# Provider-neutral OpenAI-compatible chat completions
AI_CHAT_COMPLETIONS_URL=
AI_API_KEY=
AI_MODEL=

# Runtime
# observe = evidence → features → inference → proposed MCP call(s) (dry-run)
# execute = HOLD never writes; REDUCE decreases once; REBALANCE decrease→create with state
AGENT_MODE=observe

# Optional NFT filter/debug only. When unset, manage all active positions from
# list_v3_positions (requires truncated=false).
NFT_TOKEN_ID=
CHAIN_ID=11155111

# In-progress REBALANCE recovery (default: .lp-agent-state.json in cwd)
# LP_AGENT_STATE_FILE=.lp-agent-state.json

# Explicit operator-approved create retry after decrease (default off — prefer list reconciliation)
# One-shot only: after createRetryAttempted=true, further remints are refused.
# LP_AGENT_ALLOW_CREATE_RETRY=false
# Optional: authorize a specific cycle id
# LP_AGENT_ALLOW_CREATE_RETRY_CYCLE_ID=

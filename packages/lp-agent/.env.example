# Orloj Uniswap MCP (JSON-RPC tools/call)
# Example: http://127.0.0.1:3001/interface/uniswap/mcp
ORLOJ_MCP_URL=
ORLOJ_MCP_API_KEY=

# The Graph decentralized gateway (Bearer auth — do not put the key in the URL)
THE_GRAPH_API_KEY=
# Optional override; default is the Sepolia uniswap-v3 subgraph below
# THE_GRAPH_SUBGRAPH_ID=2vXTcbEvA3TGTufatwRVUXQjJZDKCHmzZmZKYYXxaeeR
# THE_GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api/subgraphs/id

# Provider-neutral OpenAI-compatible chat completions
AI_CHAT_COMPLETIONS_URL=
AI_API_KEY=
AI_MODEL=

# Runtime
# observe = full evidence → features → inference → proposed MCP call (dry-run)
# execute = Phase 1 prints the exact MCP call marked pending; real writes are Phase 2
AGENT_MODE=observe

# Sepolia Uniswap V3 position NFT (decimal string)
NFT_TOKEN_ID=
CHAIN_ID=11155111

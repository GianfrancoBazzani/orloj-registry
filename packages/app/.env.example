# Agent chat sessions (requires a long-lived Node server with zeroclaw installed).
# Relative paths resolve against the app package root, captured once at module load —
# prefer absolute paths under `next start` or a process manager.
ZEROCLAW_BIN="zeroclaw"
ZEROCLAW_TEMPLATE_DIR="../zeroclaw-agents/default"
ZEROCLAW_MODEL_API_KEY=""
ZEROCLAW_AGENTS_DIR=".zeroclaw/agents"
ZEROCLAW_SESSION_TIMEOUT_SECS="3600"
ZEROCLAW_IDLE_TIMEOUT_MS="1800000"

# Graph LP Manager (app-hosted MCP for ZeroClaw chat)
# Makes the internal LP Manager appear as a selectable chat MCP
LP_AGENT_MCP_URL="http://127.0.0.1:3000/api/lp-agent/mcp"

THE_GRAPH_API_KEY=""

# Full Chat Completions endpoint, not merely the 0G base URL
LP_AGENT_AI_CHAT_COMPLETIONS_URL="https://router-api.0g.ai/v1/chat/completions"
LP_AGENT_AI_MODEL="deepseek-v4-flash"

# Optional; fall back to ZEROCLAW_MODEL_API_KEY if intentionally sharing the 0G key
LP_AGENT_AI_API_KEY=""

LP_AGENT_STATE_DIR=".lp-agent/state"

# Off by default; when false, do not advertise the execute tool
LP_AGENT_CHAT_EXECUTE_ENABLED="false"
